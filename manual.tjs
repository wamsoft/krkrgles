adaptor.setScreenSize(800, 600);
var dest = new Layer(window, null);   // 結果格納先レイヤ


// --- 1) 素材を加工せずそのまま描画 -------------------------------------
adaptor.capture(dest, function(w, h, p) {
    drawLayer(src, 1, 0, 0, 1, 0, 0);   // src レイヤをそのまま描画
}, void, 0x00000000 /* 透明クリア */);


// --- 2) モジュールごとに別々のエフェクトを掛ける -----------------------
adaptor.capture(dest, function(w, h, p) {

    // 背景はそのまま
    drawLayer(bgLayer, 1, 0, 0, 1, 0, 0);

    // キャラ A はグレースケール + ガンマ (点処理2つは1パスに融合される)
    beginEffect();
        drawLayer(charA, 1, 0, 0, 1, 100, 50);
    endEffect([
        %[ cmd:"grayscale" ],
        %[ cmd:"gamma", value:1.3 ],
    ]);

    // キャラ B はガウスぼかし + セピア寄せ
    beginEffect();
        drawLayer(charB, 1, 0, 0, 1, 400, 50);
    endEffect([
        %[ cmd:"gaussianBlur", radius:3 ],
        %[ cmd:"modulate", hue:30, saturation:-40, luminance:0 ],
    ]);

    // キャラ C を青っぽく着色 (乗算で半透明の青を全面に重ねる = overcolor)
    beginEffect();
        drawLayer(charC, 1, 0, 0, 1, 600, 50);
    endEffect([
        // 0x80_4080FF: α=0x80(50%) の青を Multiplicative(5) で合成
        %[ cmd:"overcolor", color:0x804080FF, type:5 ],
    ]);

}, void, 0x00000000);

